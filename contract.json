 "claims":
 [{"status": "proved",
   "statement":
   "checkerboard (n : ℕ) [NeZero n] (h2 : 2 ∣ n) (t : ℕ) (c : ZMod 2) (s : State n) : labelMass n h2 t c ((stepState n)^[t] s) = labelMass n h2 0 c s",
   "name": "TimesArrow.LatticeGas.checkerboard",
   "doc":
   "Checkerboard (even n only): every particle carries the label\n(x + y + t) mod 2 forever — streaming moves it to the other sublattice each\nstep and collisions happen within a sublattice — so the mass sitting on each\nlabelled checkerboard is conserved. The wrap across the periodic seam keeps\nthe labelling consistent only when n is even; odd n has no such invariant.",
   "axioms": ["propext", "Classical.choice", "Quot.sound"]},
  {"status": "proved",
   "statement": "collide_collide (s : UInt32) : collide (collide s) = s",
   "name": "TimesArrow.LatticeGas.collide_collide",
   "doc": "Collisions are their own inverse.",
   "axioms": ["propext"]},
  {"status": "proved",
   "statement":
   "collide_flip : ∀ s : Fin 16, collide (flip s.val.toUInt32) = flip (collide s.val.toUInt32)",
   "name": "TimesArrow.LatticeGas.collide_flip",
   "doc": "Collisions commute with velocity reversal.",
   "axioms": ["propext", "Quot.sound"]},
  {"status": "proved",
   "statement":
   "collide_mass : ∀ s : Fin 16, mass (collide s.val.toUInt32) = mass s.val.toUInt32",
   "name": "TimesArrow.LatticeGas.collide_mass",
   "doc": "Collisions conserve the particle number.",
   "axioms": ["propext", "Quot.sound"]},
  {"status": "proved",
   "statement":
   "column_momentum_refuted : ∑ y, px16 (stepState 4 east4 (0, y)) ≠ ∑ y, px16 (east4 (0, y))",
   "name": "TimesArrow.LatticeGas.column_momentum_refuted",
   "doc":
   "Refuted: x-momentum is not conserved per column. A single east-going\nparticle on the 4×4 lattice carries its x-momentum from column 0 into\ncolumn 1 in one step. Per-row y-momentum fails the same way.",
   "axioms": ["propext", "Classical.choice", "Quot.sound"]},
  {"status": "proved",
   "statement":
   "lightcone (n : ℕ) [NeZero n] (t : ℕ) (p : Site n) (s₁ s₂ : State n) (h : ∀ q ∈ diamond n p t, s₁ q = s₂ q) : (stepState n)^[t] s₁ p = (stepState n)^[t] s₂ p",
   "name": "TimesArrow.LatticeGas.lightcone",
   "doc":
   "Light cone: after `t` steps the value at any site `p` depends only on\nthe initial values within lattice L1 distance `t` of `p` — the diamond\n|dx| + |dy| ≤ t with periodic distance, so it wraps around the lattice.",
   "axioms": ["propext", "Classical.choice", "Quot.sound"]},
  {"status": "proved",
   "statement":
   "lightcone_point (n : ℕ) [NeZero n] (t : ℕ) (r p : Site n) (s₁ s₂ : State n) (h : ∀ q, q ≠ r → s₁ q = s₂ q) (hp : p ∉ diamond n r t) : (stepState n)^[t] s₁ p = (stepState n)^[t] s₂ p",
   "name": "TimesArrow.LatticeGas.lightcone_point",
   "doc":
   "A change at a single site `r` can only be seen, `t` steps later, at\nsites within `r`'s diamond of radius `t`.",
   "axioms": ["propext", "Classical.choice", "Quot.sound"]},
  {"status": "proved",
   "statement":
   "loschmidt_echo (n : ℕ) [NeZero n] (t : ℕ) (s : State n) : revState n ((stepState n)^[t] (revState n ((stepState n)^[t] s))) = s",
   "name": "TimesArrow.LatticeGas.loschmidt_echo",
   "doc":
   "The Loschmidt echo: evolve `t` steps, reverse every velocity and collide,\nevolve `t` steps, and do it again: every state returns to itself.",
   "axioms": ["propext", "Classical.choice", "Quot.sound"]},
  {"status": "proved",
   "statement":
   "mass_conserved (n : ℕ) [NeZero n] (s : State n) : ∑ p, mass16 (stepState n s p) = ∑ p, mass16 (s p)",
   "name": "TimesArrow.LatticeGas.mass_conserved",
   "doc": "HPP conserves the total number of particles.",
   "axioms": ["propext", "Classical.choice", "Quot.sound"]},
  {"status": "proved",
   "statement":
   "momentum_conserved (n : ℕ) [NeZero n] (s : State n) : (∀ y : ZMod n, ∑ x, px16 (stepState n s (x, y)) = ∑ x, px16 (s (x, y))) ∧ (∀ x : ZMod n, ∑ y, py16 (stepState n s (x, y)) = ∑ y, py16 (s (x, y))) ∧ (∑ p, px16 (stepState n s p) = ∑ p, px16 (s p)) ∧ (∑ p, py16 (stepState n s p) = ∑ p, py16 (s p))",
   "name": "TimesArrow.LatticeGas.momentum_conserved",
   "doc":
   "HPP conserves momentum in the direction it can be carried: the\nx-momentum of each row (#east − #west summed along the row) and the\ny-momentum of each column are invariant, and so are both components of the\ntotal momentum.",
   "axioms": ["propext", "Classical.choice", "Quot.sound"]},
  {"status": "proved",
   "statement":
   "step_inverse (n : ℕ) [NeZero n] : Function.Bijective (stepState n) ∧ ∀ s : State n, stepState n (revState n (stepState n (revState n s))) = s ∧ revState n (stepState n (revState n (stepState n s))) = s",
   "name": "TimesArrow.LatticeGas.step_inverse",
   "doc":
   "One HPP step is a bijection. Its inverse is the step conjugated by\n`revState`: reverse every velocity and collide (an involution), step, and do\nboth again. Plain velocity reversal does not invert the step — with\nstep = stream ∘ collide, flip ∘ step ∘ flip = stream⁻¹ ∘ collide, which\ndiffers from step⁻¹ = collide ∘ stream⁻¹ because collisions and streaming\ndo not commute.",
   "axioms": ["propext", "Classical.choice", "Quot.sound"]},
  {"status": "proved",
   "statement": "philox_kat : ∀ v ∈ kat, philox v.1 v.2.1 v.2.2.1 = v.2.2.2",
   "name": "TimesArrow.Philox.philox_kat",
   "doc": "Philox matches the Random123 known-answer vectors.",
   "axioms": ["propext", "Quot.sound"]}],
 "allowedAxioms": ["propext", "Classical.choice", "Quot.sound"]}
